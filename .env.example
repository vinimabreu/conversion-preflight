# Sanity organization token with the Context Viewer role (read-only, server side only)
SANITY_ORGANIZATION_TOKEN=
# Context MCP endpoint serving the knowledge base
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v1/context/organizations/<org-id>/mcp/<endpoint-name>
# Context MCP endpoint serving the dataset with the normalizationRule documents
SANITY_DATASET_MCP_URL=https://api.sanity.io/v1/context/organizations/<org-id>/mcp/<endpoint-name>

# Only for publishing the rule table: python -m preflight.sanity_sync --apply
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_PROJECT_TOKEN=
